-- Integrated Rejoin by Bases
local coreGui = game:GetService("CoreGui")
local teleportService = game:GetService("TeleportService")
local guiService = game:GetService("GuiService")
local players = game:GetService("Players")
local userInputService = game:GetService("UserInputService")

local function triggerRejoin()
    teleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, players.LocalPlayer)
end

userInputService.InputBegan:Connect(function(input, processed)
    if not processed and input.KeyCode == Enum.KeyCode.J and guiService.MenuIsOpen then
        triggerRejoin()
    end
end)
local creditLabel

guiService.MenuOpened:Connect(function()
    local bottomFrame = coreGui:FindFirstChild("RobloxGui"):FindFirstChild("SettingsClippingShield"):FindFirstChild("SettingsShield"):FindFirstChild("MenuContainer"):FindFirstChild("Page"):FindFirstChild("BottomButtonFrame"):FindFirstChild("MenuButtons")
    local serverChannel = coreGui:FindFirstChild("RobloxGui"):FindFirstChild("SettingsClippingShield"):FindFirstChild("SettingsShield"):FindFirstChild("VersionContainer"):WaitForChild("ServerChannelLabel", true)

    if serverChannel then
        creditLabel = serverChannel:Clone()
        creditLabel.Name = "IntegratedRejoinCreditLabel"
        creditLabel.Text = "Integrated Rejoin by <b><font color='#69aee5'>Bases</font></b>"
        creditLabel.Size = UDim2.new(0, 156, 0, 26)
        creditLabel.LayoutOrder = 7
        creditLabel.RichText = true
        creditLabel.Parent = serverChannel.Parent
    end

    local templateButton = bottomFrame:FindFirstChild("MenuButtonContainer1") or bottomFrame:FindFirstChild("MenuButtonContainer2")

    if templateButton then
        local existingContainer = bottomFrame:FindFirstChild("MenuButtonContainer3")
        if existingContainer then
            existingContainer.LayoutOrder = 4
            existingContainer.Name = "MenuButtonContainer4"
        end

        local rejoinButton = templateButton:Clone()
        rejoinButton.Name = "MenuButtonContainer3"
        rejoinButton.LayoutOrder = 3
        
        local textLabel = rejoinButton:FindFirstChildWhichIsA("TextLabel", true)
        if textLabel then
            textLabel.Text = "Rejoin"
        end
        
        local hint = rejoinButton:FindFirstChild("Hint", true)
        if hint then
            hint.Image = "rbxassetid://109358602604497"
            hint.ImageRectOffset = Vector2.new(0, 0)
            hint.ImageRectSize = Vector2.new(0, 0)
        end

        rejoinButton.MenuButton.MouseEnter:Connect(function()
            rejoinButton.MenuButton.Transparency = 0.81
        end)

        rejoinButton.MenuButton.MouseLeave:Connect(function()
            rejoinButton.MenuButton.Transparency = 0.88
        end)

        local clickableAction = rejoinButton:IsA("GuiButton") and rejoinButton or rejoinButton:FindFirstChildWhichIsA("GuiButton", true)
        
        if clickableAction then
            clickableAction.MouseButton1Click:Connect(triggerRejoin)
        end

        rejoinButton.Parent = bottomFrame
    end
end)

guiService.MenuClosed:Connect(function()
    creditLabel:Destroy()
end)
