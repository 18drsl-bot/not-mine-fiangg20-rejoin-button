-- Integrated Rejoin by Bases (using the .rj rejoin method)
local coreGui = game:GetService("CoreGui")
local teleportService = game:GetService("TeleportService")
local guiService = game:GetService("GuiService")
local players = game:GetService("Players")
local userInputService = game:GetService("UserInputService")
local runService = game:GetService("RunService")

local player = players.LocalPlayer
local rejoining = false

-- Robust rejoin: same server if possible, otherwise a fresh server.
local function triggerRejoin()
    if runService:IsStudio() then
        return
    end
    if rejoining then
        return
    end

    if game.PrivateServerId ~= "" then
        -- Scripts can't rejoin private servers; fall back to a new server.
        rejoining = true
        pcall(function()
            teleportService:Teleport(game.PlaceId, player)
        end)
        return
    end

    rejoining = true
    local ok = pcall(function()
        teleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, player)
    end)
    if not ok then
        pcall(function()
            teleportService:Teleport(game.PlaceId, player)
        end)
    end
end

-- If the same server can't be entered, fall back to any server.
teleportService.TeleportInitFailed:Connect(function(plr)
    if plr == player and rejoining then
        rejoining = false
        pcall(function()
            teleportService:Teleport(game.PlaceId, player)
        end)
    end
end)

-- Press J in the Roblox menu to rejoin.
userInputService.InputBegan:Connect(function(input, processed)
    if not processed and input.KeyCode == Enum.KeyCode.J and guiService.MenuIsOpen then
        triggerRejoin()
    end
end)

local creditLabel

guiService.MenuOpened:Connect(function()
    local robloxGui = coreGui:FindFirstChild("RobloxGui")
    if not robloxGui then return end

    local settingsClippingShield = robloxGui:FindFirstChild("SettingsClippingShield")
    if not settingsClippingShield then return end

    local settingsShield = settingsClippingShield:FindFirstChild("SettingsShield")
    if not settingsShield then return end

    local menuContainer = settingsShield:FindFirstChild("MenuContainer")
    local page = menuContainer and menuContainer:FindFirstChild("Page")
    local bottomButtonFrame = page and page:FindFirstChild("BottomButtonFrame")
    local menuButtons = bottomButtonFrame and bottomButtonFrame:FindFirstChild("MenuButtons")
    if not menuButtons then return end

    local versionContainer = settingsClippingShield:FindFirstChild("VersionContainer")
    local serverChannel = versionContainer and versionContainer:WaitForChild("ServerChannelLabel", true)

    if serverChannel then
        creditLabel = serverChannel:Clone()
        creditLabel.Name = "IntegratedRejoinCreditLabel"
        creditLabel.Text = "Integrated Rejoin by <b><font color='#69aee5'>Bases</font></b>"
        creditLabel.Size = UDim2.new(0, 156, 0, 26)
        creditLabel.LayoutOrder = 7
        creditLabel.RichText = true
        creditLabel.Parent = serverChannel.Parent
    end

    local templateButton = menuButtons:FindFirstChild("MenuButtonContainer1") or menuButtons:FindFirstChild("MenuButtonContainer2")

    if templateButton then
        local existingContainer = menuButtons:FindFirstChild("MenuButtonContainer3")
        if existingContainer then
            existingContainer.LayoutOrder = 4
            existingContainer.Name = "MenuButtonContainer4"
        end

        local rejoinButton = templateButton:Clone()
        rejoinButton.Name = "MenuButtonContainer3"
        rejoinButton.LayoutOrder = 3

        local textLabel = rejoinButton:FindFirstChildWhichIsA("TextLabel", true)
        if textLabel then
            textLabel.Text = "Rejoin"
        end

        local hint = rejoinButton:FindFirstChild("Hint", true)
        if hint then
            hint.Image = "rbxassetid://109358602604497"
            hint.ImageRectOffset = Vector2.new(0, 0)
            hint.ImageRectSize = Vector2.new(0, 0)
        end

        rejoinButton.MenuButton.MouseEnter:Connect(function()
            rejoinButton.MenuButton.Transparency = 0.81
        end)

        rejoinButton.MenuButton.MouseLeave:Connect(function()
            rejoinButton.MenuButton.Transparency = 0.88
        end)

        local clickableAction = rejoinButton:IsA("GuiButton") and rejoinButton or rejoinButton:FindFirstChildWhichIsA("GuiButton", true)

        if clickableAction then
            clickableAction.MouseButton1Click:Connect(triggerRejoin)
        end

        rejoinButton.Parent = menuButtons
    end
end)

guiService.MenuClosed:Connect(function()
    if creditLabel then
        creditLabel:Destroy()
        creditLabel = nil
    end
end)
